<?xml version="1.0"?>
<!--
    Connect IQ manifest for the "Clou" watch face.
    The application id below is a one-time generated UUID that uniquely
    identifies this app. Do not change it once the app is published.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="ClouApp"
        id="e8aac3b4c4274f359419053fa3194caf"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watchface">

        <!--
            Round 454 x 454 watch-face targets, matching Venu 4 (45 mm).
            Some product ids cover several watch models and case sizes.
            Install all these device packages in the Connect IQ SDK Manager
            before exporting a release.
        -->
        <iq:products>
            <iq:product id="venu3"/>
            <iq:product id="venu445mm"/>
            <iq:product id="approachs7047mm"/>
            <iq:product id="d2mach2"/>
            <iq:product id="d2mach2pro"/>
            <iq:product id="descentmk351mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix947mm"/>
            <iq:product id="fenix9pro47mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
        </iq:products>

        <!-- Positioning: read the last known location for sunrise/sunset. -->
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
