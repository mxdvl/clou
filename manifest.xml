<?xml version="1.0"?>
<!--
    Connect IQ manifest for the "Boussole" watch face.
    The application id below is a one-time generated UUID that uniquely
    identifies this app. Do not change it once the app is published.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="BoussoleApp"
        id="e8aac3b4c4274f359419053fa3194caf"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watchface">

        <!--
            Devices this watch face is built for. Add or remove product ids to
            match the hardware you want to target. Every id here must be a
            device supported by your installed SDK (see the device reference in
            the Connect IQ SDK Manager).
        -->
        <iq:products>
            <iq:product id="venu445mm"/>
            <iq:product id="fr970"/>
        </iq:products>

        <!-- Positioning: read the last known location for sunrise/sunset. -->
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
